  {
    title: 'Proinfa: os efeitos da política de incentivo às energias renováveis no Brasil',
    journal: 'Nexo Políticas Públicas',
    date: '2025-12-10',
    doi: 'https://pp.nexojornal.com.br/ponto-de-vista/2025/12/10/proinfa-os-efeitos-da-politica-de-incentivo-as-energias-renovaveis-no-brasil',
  },
  {
    title: 'A proibição do uso de celulares em escolas melhora o desempenho dos estudantes?',
    journal: 'Nexo Políticas Públicas',
    date: '2025-11-26',
    doi: 'https://pp.nexojornal.com.br/ponto-de-vista/2025/11/26/a-proibicao-do-uso-de-celulares-em-escolas-melhora-o-desempenho-dos-estudantes',
