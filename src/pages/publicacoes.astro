  },
  {
    title: 'Programa Bolsa Verde: síntese de evidências',
    journal: 'Nexo Políticas Públicas',
    date: '2026-09-24',
    doi: 'https://pp.nexojornal.com.br/ponto-de-vista/2026/09/24/programa-bolsa-verde-sintese-de-evidencias',
  },
  {
    title: 'Facilitadores e barreiras à implementação da PrEP no Brasil para a população LGBTQIA+',
    journal: 'Nexo Políticas Públicas',
    date: '2026-08-24',
    doi: 'https://pp.nexojornal.com.br/ponto-de-vista/2026/08/24/facilitadores-e-barreiras-a-implementacao-da-prep-no-brasil-para-a-populacao-lgbtqia',
  },
  {
    title: 'Políticas habitacionais aumentam a polarização local?',
    journal: 'Nexo Políticas Públicas',
    date: '2026-07-13',
    doi: 'https://pp.nexojornal.com.br/ponto-de-vista/2026/07/13/politicas-habitacionais-aumentam-a-polarizacao-local',
